        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n:创建人发起任务;\n:保存为草稿 S01;\n\nif (创建人是否取消?) then (是)\n  :已取消 S09;\n  stop\nelse (否)\n  :提交审核;\n  :待审核 S02;\n  \n  if (审核人是否驳回?) then (是)\n    :审核已驳回 S03;\n    \n    if (创建人是否取消?) then (是)\n      :已取消 S09;\n      stop\n    else (否)\n      :创建人修改任务;\n      :提交审核;\n      :待审核 S02;\n      \n      if (审核人是否驳回?) then (是)\n        :审核已驳回 S03;\n        :已取消 S09;\n        stop\n      else (否)\n        :待执行 S04;\n      endif\n    endif\n  else (否)\n    :待执行 S04;\n  endif\n  \n  :执行人点击开始执行 执行中 S05;\n  :执行人提交完成 待复核 S06;\n  \n  if (审核人是否驳回复核?) then (是)\n    :复核已驳回 S07;\n    :执行人重新操作 执行中 S05;\n    :执行人提交完成 待复核 S06;\n    \n    if (审核人是否驳回复核?) then (是)\n      :复核已驳回 S07;\n      :已取消 S09;\n      stop\n    else (否)\n      :同步阀门状态至水力模型;\n      :已完成 S08;\n      stop\n    endif\n  else (否)\n    :同步阀门状态至水力模型;\n    :已完成 S08;\n    stop\n  endif\nendif\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="nYD9o_ZsDtUlt_OvqJtd-107">
